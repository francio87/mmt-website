---
const { content } = Astro.props;
---
<section class="faq section" id="faq" aria-labelledby="faq-title"><div class="faq-heading"><p class="eyebrow dark">{content.kicker}</p><h2 id="faq-title">{content.title}</h2></div><div class="faq-list">{content.items.map(([question, answer]) => <details class="faq-item"><summary><h3>{question}</h3></summary><p>{answer}</p></details>)}</div></section>
